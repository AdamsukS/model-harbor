# ModelHarbor HTTP server
MODEL_HARBOR_HOST=127.0.0.1
MODEL_HARBOR_PORT=8787
MODEL_HARBOR_MAX_USERS=5
MODEL_HARBOR_QUEUE_SIZE=5
MODEL_HARBOR_CONCURRENCY=1

# Agent and context
MODEL_HARBOR_AGENT_ID=agent.model-harbor.local
MODEL_HARBOR_TENANT_ID=model-harbor.local
MODEL_HARBOR_CONTEXT_TOKENS=131072
MODEL_HARBOR_CONTEXT_CHARACTERS=360000

# Ollama inference
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_SOURCE_MODEL=qwen3.5:9b-q4_K_M
OLLAMA_MODEL=qwen3.5:9b-128k
OLLAMA_TIMEOUT_MS=300000

# Plasmod memory
PLASMOD_BASE_URL=http://127.0.0.1:8080
PLASMOD_TIMEOUT_MS=10000
PLASMOD_TOP_K=5
