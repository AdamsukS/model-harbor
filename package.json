    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@codesoul-co/hypha-core": "1.0.1",
    "@codesoul-co/hypha-domain": "1.0.1",
    "@codesoul-co/hypha-memory": "1.0.1"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  },
  "packageManager": "pnpm@11.19.0"
}
