{
  "name": "model-harbor",
  "version": "0.2.0",
  "private": true,
  "description": "Local-first multi-model Agent runtime using Hypha, Plasmod, and native inference backends.",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/main.ts",
